# Compatibility scheduler until the Rust loop has verified production quote
# coverage during trading hours. See deploy/README.md for the cutover.
[Unit]
Description=AStock V2 intraday quote feed, AI observer and 3-minute scheduler
After=network-online.target astock-live.service
Wants=network-online.target
Requires=astock-live.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=astock
Group=astock
WorkingDirectory=/opt/astock-live
EnvironmentFile=/etc/astock-live.env
ExecStart=/usr/bin/python3 scripts/live_paper_loop.py --api http://127.0.0.1:18765 --universe /opt/astock-live/live-a-universe.txt --history-db /opt/astock-live/history-closes.json --interval 180 --ai on --timezone Asia/Shanghai
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/astock-live /opt/astock-live/work
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

[Unit]
Description=AStock V2 read-only close research and isolated strategy replay
After=astock-live.service
StartLimitIntervalSec=2h
StartLimitBurst=2

[Service]
Type=oneshot
User=astock
Group=astock
WorkingDirectory=/opt/astock-live-evolution
EnvironmentFile=/etc/astock-live.env
StateDirectory=astock-live-evolution
StateDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/astock-live-evolution/scripts/intraday_evolution.py daily --db /var/lib/astock-live/intraday.sqlite3 --history /opt/astock-live/history-closes.json --calendar /opt/astock-live/data/calendar-2026-v1.json --root /var/lib/astock-live-evolution --kernel /opt/astock-live/bin/astock-v2 --ai
TimeoutStartSec=90min
Restart=on-failure
RestartSec=10min
Nice=15
MemoryMax=2G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

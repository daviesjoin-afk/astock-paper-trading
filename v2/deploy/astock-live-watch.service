[Unit]
Description=Read-only AStock V2 paper-session health check

[Service]
Type=oneshot
User=astock
Group=astock
WorkingDirectory=/opt/astock-live
ExecStart=/opt/astock-live/bin/astock-v2 live-watch --api http://127.0.0.1:18765 --calendar /opt/astock-live/data/calendar-2026-v1.json
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

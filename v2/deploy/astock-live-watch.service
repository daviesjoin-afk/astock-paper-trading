[Unit]
Description=Read-only AStock V2 paper-session health check

[Service]
Type=oneshot
User=astock
Group=astock
WorkingDirectory=/opt/astock-v2-rewrite
ExecStart=/opt/astock-v2-rewrite/bin/astock-v2 live-watch --api http://127.0.0.1:18765
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

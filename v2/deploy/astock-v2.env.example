# Copy to /etc/astock-v2-rewrite.env and edit. The kernel never reads the wall
# clock; schedulers pass the trading day explicitly.
# Use a NEW path after the rewrite; legacy databases are refused on purpose.
ASTOCK_V2_DB=/var/lib/astock-v2-rewrite/v2.sqlite3
# Optional: directory of reviewed price sets (*.json published by
# scripts/publish_price_set.sh). Empty means valuation stays unavailable.
ASTOCK_PRICE_SETS_DIR=/var/lib/astock-v2-rewrite/price-sets
# Optional: bind the HTTP listener. Keep loopback and proxy through nginx.
ASTOCK_V2_ADDR=127.0.0.1:18765

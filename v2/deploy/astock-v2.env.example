# Copy to /etc/astock-v2.env and edit. The kernel never reads the wall clock;
# schedulers pass the trading day explicitly.
ASTOCK_V2_DB=/var/lib/astock-v2/astock-v2.sqlite3
# Optional: directory of reviewed price sets (*.json published by
# scripts/publish_price_set.sh). Empty means valuation stays unavailable.
ASTOCK_PRICE_SETS_DIR=/var/lib/astock-v2/price-sets
# Optional: backup directory whose *.manifest.json are listed read-only.
ASTOCK_ARCHIVE_DIR=/var/backups/astock-v2

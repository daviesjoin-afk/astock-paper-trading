# astock-paper-trading 本地运行示例环境变量
# 复制为 .env 使用（.env 已被 gitignore，不会上传）。
# 全部为可选配置：不设置也能以"基础模式"启动（无 LLM/AI 调优、无自动点火）。

# ---- 可选：LLM / AI 调优（deepseek_advisor / dual_ai_tuner / adaptive_*）
# 不设置则相关 AI 可选特性保持关闭，引擎与模拟盘不受影响。
#DEEPSEEK_API_KEY=sk-xxxx
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#LLM_ADVISOR_ENABLED=0

# ---- 可选：运行时目录（默认仓库根下的 data_cache/，自动创建）
#ASTOCK_CACHE_DIR=/abs/path/to/data_cache

# ---- 可选：主力点火买入通道（研究默认关闭；开启须自行承担回测风险）
#PAPER_IGNITION_BUY=0

# ---- 可选：并发/限流调优（一般无需改动）
#ASTOCK_ENABLE_FALLBACK_THREADS=0
#MODLENS_MAX_CONCURRENCY=1
#DEEPSEEK_TIMEOUT_SECONDS=60

# astock-paper-trading 本地运行示例环境变量
# 复制为 .env 使用（.env 已被 gitignore，不会上传）。
# 全部为可选配置：不设置也能以"基础模式"启动（无 LLM/AI 调优、无自动点火）。

# ---- 可选：LLM / AI 调优（deepseek_advisor / dual_ai_tuner / adaptive_*）
# 不设置则相关 AI 可选特性保持关闭，引擎与模拟盘不受影响。
#DEEPSEEK_API_KEY=sk-xxxx
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#LLM_ADVISOR_ENABLED=0

# ---- 可选：运行时目录（默认仓库根下的 data_cache/，自动创建）
#ASTOCK_CACHE_DIR=/abs/path/to/data_cache

# ---- 可选：主力点火买入通道（研究默认关闭；开启须自行承担回测风险）
#PAPER_IGNITION_BUY=0

# ---- 可选：并发/限流调优（一般无需改动）
#ASTOCK_ENABLE_FALLBACK_THREADS=0
#MODLENS_MAX_CONCURRENCY=1
#DEEPSEEK_TIMEOUT_SECONDS=60

# ---- 操作员安全边界（PR-2）------------------------------------------------
# 写接口（POST/PUT/PATCH/DELETE）的共享密钥。三种配置状态对应三种运行模式：
#
#   UNSET（不存在或为空）  local-only   仅环回客户端可写；远端写请求 403
#   VALID（>= 24 字符）    authenticated 任何客户端的写请求都必须带 Bearer
#   INVALID（存在但太弱）  misconfigured 所有写请求 503（绝不降级）
#
# 生成一个强随机 token（>= 24 字符）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 唯一支持的携带方式是标准请求头，Bearer 方案（绝不进 URL/query/日志）：
#   请求头名称 Authorization，值形如「Bearer <token>」（scheme 与凭据之间一个空格）
#
# 真正的密钥请写入 .env（已被 gitignore），不要提交到仓库。
# 本文件仅作示例，不要在此写真实密钥。
#ASTOCK_OPERATOR_TOKEN=replace-with-a-random-token-at-least-24-chars

# 注意：**不存在**任何关闭操作员边界的开关。如需本机免鉴权，保持 UNSET 即可
# （local-only 模式）；该模式不应通过额外网络转发对外暴露。

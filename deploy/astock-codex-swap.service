[Unit]
Description=AStock Codex swap safety file
DefaultDependencies=no
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/swapon <SERVER_PATH>/.swapfile
ExecStop=/usr/sbin/swapoff <SERVER_PATH>/.swapfile
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

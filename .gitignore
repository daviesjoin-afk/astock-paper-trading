# 运行时数据与产物（体积大、机器相关，不入库）
data_cache/
reports/
backups/
cp/
logs/
# Defense in depth: never stage local ledgers if a tool writes one outside
# the standard runtime directory.
*.sqlite
*.sqlite3
*.db
*.db-*

# 部署暂存目录与运行时锁（临时工作副本，不入库）
.locks/
.codex-test-tmp/
.staging/
.staging-p0/
.staging-market-policy-fix/
.server-fast-entry/
.server-main-force/
.server-*/

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# 日志与临时文件
*.log
server.log
tmp_pytest/
*.tmp
*.bak

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 运行数据（本地会话记忆，不入库）
.workbuddy/

# 历史增量备份/临时文件（本地开发用，不入库）
*.before-*
*.before_*
*.bak-*
*.bak_*
*.tmp.*
*.old

# 本机密钥与运行时数据（clone 后自行生成，绝不上传）
.env
.env.*
!.env.example
